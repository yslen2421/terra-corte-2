# Estructuras de control

fijo emisiones = [12.4, 8.1, 0.0, 15.7, 3.2]

para valor en emisiones:
    si valor > 10.0:
        mostrar("Emision alta:", valor)
    sino si valor == 0.0:
        mostrar("Sin registro")
    sino:
        mostrar("Emision moderada:", valor)
    fin
fin

var anio = 2019
mientras anio <= 2023:
    mostrar("Procesando anio", anio)
    anio = anio + 1
fin

